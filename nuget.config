<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <config>
        <add key="defaultPushSource" value="github-webczat"/>
    </config>
  <packageSources>
    <!--To inherit the global NuGet package sources remove the <clear/> line below -->
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="github-webczat" value="https://nuget.pkg.github.com/webczat/index.json"/>
  </packageSources>
  <packageSourceMapping>
<packageSource key="nuget">
    <package pattern="*"/>
</packageSource>
<packageSource key="github-webczat">
    <package pattern="Webczat.*"/>
</packageSource>
  </packageSourceMapping>
</configuration>
